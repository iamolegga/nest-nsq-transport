{
  "name": "nest-nsq-transport",
  "version": "0.4.0",
  "description": "NestJS microservice transport for NSQ",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noemit && biome check src __tests__",
    "lint:fix": "tsc --noemit && biome check --write src __tests__",
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json",
    "nsqd": "docker run --rm -p 4150:4150 -p 4151:4151 iamolegga/nsqd"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamolegga/nest-nsq-transport.git"
  },
  "keywords": [
    "nest",
    "nestjs",
    "nsq",
    "transport",
    "microservice"
  ],
  "author": "iamolegga <iamolegga@gmail.com> (http://github.com/iamolegga)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iamolegga/nest-nsq-transport/issues"
  },
  "homepage": "https://github.com/iamolegga/nest-nsq-transport#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@swc/core": "^1.16.1",
    "@types/node": "^26.4.0",
    "@types/nsqjs": "^0.12.4",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.0.0",
    "nsqjs": "^0.13.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/microservices": "^11.0.0 || ^12.0.0",
    "nsqjs": "^0.13.0"
  }
}
